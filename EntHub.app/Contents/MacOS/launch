#!/bin/bash
# EntHub 启动器（macOS .app bundle 调用入口）
# 设计目标：
#   - 不弹 Terminal.app（用户双击 .app 体验应像打开一个 native app）
#   - 后台启动 Flask，自动打开浏览器
#   - 任何失败都用原生 dialog 提示（不依赖终端）
#   - 不打包源代码（用户可继续直接修改 app.py / templates / static）

# macOS App Translocation 防护
case "$0" in
    *AppTranslocation*)
        osascript -e 'display dialog "EntHub 被系统隔离运行，无法读取项目文件。\n\n请在终端执行（路径替换为 .app 实际位置）：\n\nxattr -dr com.apple.quarantine /Users/gm/AI/EntHub/EntHub.app\n\n然后重新双击启动。" buttons {"好"} default button "好" with title "EntHub 启动失败" with icon stop' >/dev/null 2>&1
        exit 1
        ;;
esac

# 定位到 EntHub 项目根目录
DIR="$(cd "$(dirname "$0")/../../.." && pwd)"
START_SCRIPT="$DIR/start.sh"

if [ ! -f "$START_SCRIPT" ]; then
    osascript -e "display dialog \"找不到启动脚本：\n$START_SCRIPT\n\n请确认 EntHub.app 放在项目根目录。\" buttons {\"好\"} default button \"好\" with title \"EntHub 启动失败\" with icon stop" >/dev/null 2>&1
    exit 1
fi

# 用 osascript do shell script 静默启动后台模式
# - 不激活 Terminal.app
# - 错误输出被丢弃（由 start.sh 内的 dialog 处理）
osascript -e "do shell script \"'$START_SCRIPT' --bg >/dev/null 2>&1 &\"" >/dev/null 2>&1 &
